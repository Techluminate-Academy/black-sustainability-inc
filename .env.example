# ===========================================
# Wix API (for subscription automation)
# ===========================================
# Get these from the site owner's Wix account:
# 1. Headless Settings → Admin API Key → Manage API Key
# 2. Generate key with scopes: Read Orders, Read Members, Read Plans
# 3. Site ID: from dashboard URL (.../dashboard/{SITE_ID}/...)
# 4. Account ID: shown in API Keys Manager
#
# WIX_API_KEY=
# WIX_SITE_ID=
# WIX_ACCOUNT_ID=

# ===========================================
# Mighty Networks (Admin API)
# ===========================================
# MIGHTY_NETWORK_ID=
# MIGHTY_NETWORK_API_KEY=
#
# Custom Field ID for "Map Location" (text_short)
# Used by `/api/member/update-location` to keep Mighty in sync.
# MIGHTY_MAP_LOCATION_CUSTOM_FIELD_ID=
#
# Optional: Mighty custom fields for self-service profile updates (bio is not writable on the member PUT endpoint).
# MIGHTY_BIO_CUSTOM_FIELD_ID=
# MIGHTY_ORGANIZATION_CUSTOM_FIELD_ID=
#
# Profile backfill reads Mighty Members sync table (AIRTABLE_MIGHTY_SYNC_* + AIRTABLE_PAT).
# Optional view filter:
# AIRTABLE_MIGHTY_SYNC_VIEW_ID=
# Optional column names for profile mirror (scripts/airtable-create-mighty-profile-fields.ts):
# Rename Short Bio → Extended Bio in Airtable (Metadata API; needs schema.bases:write):
# npm run airtable:rename-mighty-bio-field:apply
# AIRTABLE_MIGHTY_BIO_RENAME_FROM=Short Bio
# Default write column is Extended Bio; override only if your base differs:
# AIRTABLE_MIGHTY_BIO_FIELD=Extended Bio
# During migration (both columns exist): AIRTABLE_MIGHTY_BIO_ALSO_WRITE=Extended Bio
# MIGHTY_BIO_FIELD_TITLE=Extended Bio
# AIRTABLE_MIGHTY_PROFILE_PHOTO_FIELD=Profile Photo URL
#
# Airtable Mighty Members table column for organization (default: Organization).
# AIRTABLE_MIGHTY_ORG_FIELD=Organization
#
# Mighty Members: deactivation is written to subscriptionStatuses (value: deactivated)
# AIRTABLE_SUBSCRIPTION_STATUSES_FIELD=subscriptionStatuses
#
# Mighty Members: client "excluded email" outreach cohort (scripts/flag-migration-excluded-emails.ts)
# Create columns: npx tsx scripts/airtable-create-migration-excluded-fields.ts --apply
# PAT scopes: schema.bases:read, schema.bases:write
# AIRTABLE_MIGRATION_EXCLUDED_FIELD=Migration Excluded
# AIRTABLE_MIGRATION_EXCLUDED_AT_FIELD=Migration Excluded At
# AIRTABLE_MIGRATION_EXCLUDED_REASON_FIELD=Migration Excluded Reason
# AIRTABLE_MIGRATION_EXCLUDED_TIMEZONE=America/New_York

# ===========================================
# Admin dashboard JWT (required; no fallback)
# ===========================================
# JWT_SECRET=

# ===========================================
# NextAuth email SMTP TLS
# ===========================================
# Default verifies server certificate. For local self-signed SMTP only:
# EMAIL_TLS_REJECT_UNAUTHORIZED=0

# ===========================================
# Tester impersonation (PROD, allowlisted)
# ===========================================
# Extra tester emails (comma/newline); merged with built-in QA list in lib/qaTesterAllowlist.ts
# (jerry@techluminateacademy.com, kelyce@blacksustainability.org, alexis.vidot@gmail.com, research@blacksustainability.org).
# BSN_IMPERSONATE_ALLOWLIST=
# Secret required to set impersonation cookie via /api/test/impersonate:
# BSN_IMPERSONATE_SECRET=
# In production, /api/test/impersonate returns 404 unless explicitly enabled:
# BSN_IMPERSONATE_ALLOW_PRODUCTION=1

# ===========================================
# Playwright E2E (local / CI only)
# ===========================================
# Enables POST /api/test/member-location-fixture (never in production unless E2E_TEST_ENABLED=1):
# E2E_TEST_ENABLED=1
# E2E_TEST_SECRET=
# E2E_TEST_EMAIL_ALLOWLIST=jerry@techluminateacademy.com
# E2E_TEST_EMAIL=jerry@techluminateacademy.com
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Map QA test emails (no passwords — Mighty email sign-in only): see documentation/MAP_QA_TEST_ACCOUNTS.md
# P1 paid example: projectinfo216@gmail.com | NP1: utleyp@gmail.com | NP2: akofaoyin@gmail.com

# ===========================================
# Airtable (server-only for free-signup API routes)
# ===========================================
# Prefer PAT not exposed to the browser:
# AIRTABLE_PAT=
# Optional overrides (else NEXT_PUBLIC_* may be used on server only):
# AIRTABLE_BASE_ID=
# AIRTABLE_FREE_SIGNUP_TABLE_NAME=

# Free-signup Airtable API rate limits (fixed window per IP; PATCH also per email hash).
# Uses Redis when REDIS_URL is set; otherwise in-memory (single instance only).
# FREE_SIGNUP_RL_WINDOW_SEC=900
# FREE_SIGNUP_RL_POST_MAX=10
# FREE_SIGNUP_RL_PATCH_MAX=30
# FREE_SIGNUP_RL_PATCH_EMAIL_MAX=25
# FREE_SIGNUP_RL_METADATA_MAX=120

# Legacy Wix → Airtable apply (scripts/wix-airtable-sync-apply.ts):
# ALLOW_WIX_AIRTABLE_APPLY=1

# Admin CSV batch: allow writing "Paying Member (keep current)" to Airtable (default: omit)
# ALLOW_STAFF_BATCH_PAYING_AIRTABLE=1

# Map support tickets (MapHelpModal -> POST /api/support/ticket).
# MongoDB `members` database, collection `supportTickets` (auto-created on first ticket or via npm run setup-support-tickets).
# Gmail SMTP (map support tickets, sync reports, etc.). App Password: https://myaccount.google.com/apppasswords
# EMAIL_USER=your-account@gmail.com
# EMAIL_PASSWORD=your_16_char_app_password
# Optional: To recipients for new-ticket staff alerts (comma-separated).
# Defaults to jerry@techluminateacademy.com, kelyce@blacksustainability.org
# SUPPORT_TICKET_RECIPIENTS=
# CC on all support ticket emails (staff alert + member confirmation). Raina is always included by default.
# SUPPORT_TICKET_CC=raina@blacksustainability.org
